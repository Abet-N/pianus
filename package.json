    "luxon": "^3.7.2",
    "tone": "^15.0.4",
    "webpack-node-externals": "^3.0.0"
  },
  "devDependencies": {
    "copy-webpack-plugin": "^14.0.0",
    "webpack": "^5.97.1",
    "webpack-cli": "^6.0.1"
  },
  "browser": {
    "path": false,
    "stream": false
  }
}
